@{
    var confirmed = ViewData["Confirmed"] is true;
    ViewData["Title"] = confirmed ? "Email confirmed" : "Confirmation failed";
}

<div class="container py-5 text-center">
    <div class="ht-icon mb-3"><i class="bi @(confirmed ? "bi-envelope-check" : "bi-envelope-exclamation")"></i></div>
    <h1 class="h2">@ViewData["Title"]</h1>
    <p class="text-muted">
        @(confirmed ? "Thanks! Your email is confirmed, so you'll now receive reminders and updates by email."
                    : "This confirmation link is invalid or has expired. Sign in and use “Resend link” to get a new one.")
    </p>
    <a class="btn btn-primary mt-2" asp-controller="Dashboard" asp-action="Index">Go to dashboard</a>
</div>
