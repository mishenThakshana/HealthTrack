@using HealthTrack.Controllers
@using HealthTrack.Data
@using HealthTrack.Helpers
@model HealthTrack.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    string? HiddenUnless(string role) => Model.Role == role ? null : "hidden";
}

<div class="container py-5">
    <div class="ht-auth-card ht-auth-card-wide mx-auto">
        <div class="text-center mb-4">
            <div class="ht-icon mb-3"><i class="bi bi-person-plus"></i></div>
            <h1 class="h3 fw-bold">Create your account</h1>
            <p class="text-muted mb-0">Start tracking your health and fitness today</p>
        </div>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <fieldset class="mb-4">
                <legend class="form-label fw-semibold fs-6">@Html.DisplayNameFor(m => m.Role)</legend>
                <div class="row g-2">
                    @foreach (var role in AccountController.RegisterableRoles)
                    {
                        var id = $"role-{role.ToLowerInvariant()}";
                        var (icon, hint) = role switch
                        {
                            HealthTrack.Data.Roles.Trainer => ("bi-person-badge", "Coach and manage clients"),
                            HealthTrack.Data.Roles.Professional => ("bi-hospital", "Offer health consultations"),
                            _ => ("bi-person-heart", "Track my own health")
                        };
                        <div class="col-sm-4">
                            <input type="radio" class="btn-check" asp-for="Role" value="@role" id="@id" />
                            <label class="ht-role-option w-100 h-100" for="@id">
                                <i class="bi @icon"></i>
                                <span class="fw-semibold">@HealthTrack.Data.Roles.DisplayName(role)</span>
                                <small class="text-muted">@hint</small>
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </fieldset>

            <div class="form-floating mb-3">
                <input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Full name" />
                <label asp-for="FullName"></label>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" />
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm">
                    <div class="form-floating">
                        <select asp-for="Gender" asp-items="@(new SelectList(AccountController.Genders))" class="form-select">
                            <option value="">Select</option>
                        </select>
                        <label asp-for="Gender"></label>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-sm" data-show-for-role="@Roles.Client" hidden="@HiddenUnless(Roles.Client)">
                    <div class="form-floating">
                        <input asp-for="DateOfBirth" type="date" class="form-control" placeholder="Date of birth" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <label asp-for="DateOfBirth"></label>
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <fieldset class="ht-role-section mb-3" data-show-for-role="@Roles.Trainer" hidden="@HiddenUnless(Roles.Trainer)">
                <legend class="form-label fw-semibold fs-6 mb-1"><i class="bi bi-person-badge text-primary"></i> About your coaching</legend>
                <p class="form-text mt-0 mb-2">Clients see your specialization and experience when they book an appointment.</p>
                <div class="row g-2 mb-3">
                    <div class="col-sm-7">
                        <div class="form-floating">
                            <select asp-for="Trainer.Specialization" asp-items="@(new SelectList(ProfileOptions.Specializations))" class="form-select">
                                <option value="">Select</option>
                            </select>
                            <label asp-for="Trainer.Specialization"></label>
                        </div>
                        <span asp-validation-for="Trainer.Specialization" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-5">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Trainer.YearsOfExperience" type="number" min="0" max="60" class="form-control" placeholder="0" />
                                <label asp-for="Trainer.YearsOfExperience"></label>
                            </div>
                            <span class="input-group-text">years</span>
                        </div>
                        <span asp-validation-for="Trainer.YearsOfExperience" class="text-danger small"></span>
                    </div>
                </div>
                <partial name="_QualificationsField" for="Trainer" />
            </fieldset>

            <fieldset class="ht-role-section mb-3" data-show-for-role="@Roles.Professional" hidden="@HiddenUnless(Roles.Professional)">
                <legend class="form-label fw-semibold fs-6 mb-1"><i class="bi bi-hospital text-primary"></i> About your practice</legend>
                <p class="form-text mt-0 mb-2">Clients see your profession and workplace when they book a consultation.</p>
                <div class="row g-2">
                    <div class="col-sm-7">
                        <div class="form-floating">
                            <select asp-for="Professional.Profession" asp-items="@(new SelectList(ProfileOptions.Professions))" class="form-select">
                                <option value="">Select</option>
                            </select>
                            <label asp-for="Professional.Profession"></label>
                        </div>
                        <span asp-validation-for="Professional.Profession" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-5">
                        <div class="input-group">
                            <div class="form-floating">
                                <input asp-for="Professional.YearsOfExperience" type="number" min="0" max="60" class="form-control" placeholder="0" />
                                <label asp-for="Professional.YearsOfExperience"></label>
                            </div>
                            <span class="input-group-text">years</span>
                        </div>
                        <span asp-validation-for="Professional.YearsOfExperience" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Professional.RegistrationNumber" class="form-control" maxlength="50" placeholder="Registration number" />
                            <label asp-for="Professional.RegistrationNumber"></label>
                        </div>
                        <span asp-validation-for="Professional.RegistrationNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-floating">
                            <input asp-for="Professional.Workplace" class="form-control" maxlength="100" placeholder="Workplace" />
                            <label asp-for="Professional.Workplace"></label>
                        </div>
                        <span asp-validation-for="Professional.Workplace" class="text-danger small"></span>
                    </div>
                </div>
            </fieldset>

            <div class="row g-3 mb-1">
                <div class="col-sm-6">
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Password" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm password" />
                        <label asp-for="ConfirmPassword"></label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <p class="form-text mb-3">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</p>

            <div class="form-check mb-4">
                <input asp-for="AcceptPrivacy" class="form-check-input" />
                <label asp-for="AcceptPrivacy" class="form-check-label">
                    I have read and accept the <a asp-controller="Home" asp-action="Privacy" target="_blank" rel="noopener">privacy policy</a>
                </label>
                <span asp-validation-for="AcceptPrivacy" class="text-danger small d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">Create account</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            Already have an account? <a asp-action="Login">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
