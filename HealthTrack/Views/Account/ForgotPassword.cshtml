@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    var sent = ViewData["Sent"] is true;
}

<div class="container py-5">
    <div class="ht-auth-card mx-auto">
        <div class="text-center mb-4">
            <div class="ht-icon mb-3"><i class="bi @(sent ? "bi-envelope-check" : "bi-key")"></i></div>
            <h1 class="h3 fw-bold">@(sent ? "Check your email" : "Forgot your password?")</h1>
            <p class="text-muted mb-0">
                @(sent ? $"If an account exists for {Model.Email}, we've sent a link to reset the password. It may take a minute to arrive."
                       : "Enter your email and we'll send you a link to choose a new password.")
            </p>
        </div>

        @if (!sent)
        {
            <form asp-action="ForgotPassword" method="post" novalidate>
                <div class="form-floating mb-4">
                    <input asp-for="Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2">Send reset link</button>
            </form>
        }

        <p class="text-center text-muted mt-4 mb-0">
            Remembered it? <a asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
