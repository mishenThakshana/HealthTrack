@model AppointmentDetailsViewModel
@using HealthTrack.Helpers
@* Rating & feedback for a completed (or approved and ended) appointment: the client writes or edits it; the provider and admins read it. *@
@{
    var a = Model.Appointment;
    var review = Model.Review;
    var isClient = !Model.IsProvider;
    var showForm = isClient && AppointmentRules.CanReview(a) && (review is null || Model.EditingReview);
}

@if (AppointmentRules.CanReview(a) || review is not null)
{
    <div class="ht-panel mt-3" id="review">
        <div class="ht-panel-header">
            <h2 class="h6 mb-0"><i class="bi bi-star"></i> Rating &amp; feedback</h2>
        </div>

        @if (showForm)
        {
            <p class="small text-muted">How was your appointment with @a.Trainer!.FullName? Your rating appears on their profile with your first name and initial.</p>
            <form asp-action="Review" asp-route-id="@a.Id" method="post" novalidate>
                <fieldset class="mb-3">
                    <legend class="form-label fs-6 mb-1">Your rating</legend>
                    <div class="ht-star-input">
                        @for (var stars = 5; stars >= 1; stars--)
                        {
                            <input type="radio" class="visually-hidden" id="rating-@stars" name="ReviewForm.Rating" value="@stars" checked="@(Model.ReviewForm.Rating == stars)" />
                            <label for="rating-@stars" title="@stars star@(stars == 1 ? "" : "s")">
                                <i class="bi bi-star-fill" aria-hidden="true"></i><span class="visually-hidden">@stars star@(stars == 1 ? "" : "s")</span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="ReviewForm.Rating" class="text-danger small d-block"></span>
                </fieldset>
                <div class="mb-3">
                    <label asp-for="ReviewForm.Comment" class="form-label"></label>
                    <textarea asp-for="ReviewForm.Comment" class="form-control" rows="3" maxlength="1000" placeholder="What went well? What could be better?"></textarea>
                    <span asp-validation-for="ReviewForm.Comment" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> @(review is null ? "Submit review" : "Save changes")</button>
                    @if (review is not null)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@a.Id" asp-fragment="review">Cancel</a>
                    }
                </div>
            </form>
        }
        else if (review is not null)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <partial name="_Stars" model="new RatingSummary(review.Rating, 1)" view-data='new ViewDataDictionary(ViewData) { ["Compact"] = true }' />
                <span class="small text-muted">
                    @(isClient ? "You" : a.Client!.FullName) · @review.CreatedAt.ToLocalTime().ToString("d MMM yyyy")@(review.UpdatedAt > review.CreatedAt.AddMinutes(1) ? " (edited)" : "")
                </span>
            </div>
            @if (review.Comment is not null)
            {
                <p class="ht-prewrap mb-0">@review.Comment</p>
            }
            @if (isClient || Model.IsAdmin)
            {
                <div class="d-flex gap-3 mt-3">
                    @if (isClient)
                    {
                        <a class="small" asp-action="Details" asp-route-id="@a.Id" asp-route-editReview="true" asp-fragment="review"><i class="bi bi-pencil"></i> Edit</a>
                    }
                    <form asp-action="DeleteReview" asp-route-id="@a.Id" method="post" data-confirm="Delete this review?">
                        <button type="submit" class="btn btn-link btn-sm text-danger p-0"><i class="bi bi-trash3"></i> Delete</button>
                    </form>
                </div>
            }
        }
        else
        {
            <p class="text-muted small mb-0">@a.Client!.FullName hasn't rated this appointment yet.</p>
        }
    </div>
}
