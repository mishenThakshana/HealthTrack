@model TrainerAssignmentsViewModel
@{
    ViewData["Title"] = "Trainer assignments";
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <h1 class="h3 mb-1">Trainer assignments</h1>
            <p class="text-muted mb-0">Choose which trainer looks after each client. Trainers can only see and plan for their own clients.</p>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-person"></i> Clients</h2>
                    <span class="small text-muted">@Model.Clients.Count(c => c.TrainerId is null) unassigned</span>
                </div>
                @if (Model.Clients.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyState("bi-people", "No clients have registered yet.")' />
                }
                else if (Model.Trainers.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyState("bi-person-workspace", "No trainers have registered yet.")' />
                }
                else
                {
                    <ul class="list-unstyled ht-item-list mb-0">
                        @foreach (var c in Model.Clients)
                        {
                            <li class="flex-wrap">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@c.ClientName</div>
                                    <div class="small text-muted text-break">@c.ClientEmail</div>
                                </div>
                                <form asp-action="Assign" method="post" class="d-flex gap-2 ht-assign-form">
                                    <input type="hidden" name="clientId" value="@c.ClientId" />
                                    <select name="trainerId" class="form-select form-select-sm" aria-label="Trainer for @c.ClientName">
                                        <option value="">Unassigned</option>
                                        @foreach (var t in Model.Trainers)
                                        {
                                            <option value="@t.Id" selected="@(t.Id == c.TrainerId)">@t.FullName</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-person-workspace"></i> Trainers</h2>
                </div>
                @if (Model.Trainers.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyState("bi-person-workspace", "No trainers yet.")' />
                }
                else
                {
                    <partial name="_TrainerLoads" model="Model.Trainers" />
                }
            </div>
        </div>
    </div>
</div>
