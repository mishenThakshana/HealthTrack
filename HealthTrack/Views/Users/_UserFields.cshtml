@model UserFormViewModel
@using HealthTrack.Controllers
@using HealthTrack.Data
@{
    var roles = Roles.All.Select(r => new SelectListItem(Roles.DisplayName(r), r));
    var roleLocked = ViewData["RoleLocked"] is true;
}

<div class="mb-3">
    <label asp-for="FullName" class="form-label"></label>
    <input asp-for="FullName" class="form-control" autocomplete="off" />
    <span asp-validation-for="FullName" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" autocomplete="off" />
    <span asp-validation-for="Email" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Role" class="form-label"></label>
    @if (roleLocked)
    {
        <input type="hidden" asp-for="Role" />
        <input class="form-control" value="@Roles.DisplayName(Model.Role)" disabled aria-describedby="role-help" />
        <div id="role-help" class="form-text">You can't change your own role.</div>
    }
    else
    {
        <select asp-for="Role" asp-items="roles" class="form-select"></select>
    }
    <span asp-validation-for="Role" class="text-danger small"></span>
</div>
<div class="row g-2 mb-3">
    <div class="col-sm-6">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
    </div>
    <div class="col-sm-6" data-hide-for-role="@Roles.Admin" hidden="@(Model.Role == Roles.Admin ? "hidden" : null)">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" asp-items="@(new SelectList(AccountController.Genders))" class="form-select">
            <option value="">Select</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger small"></span>
    </div>
</div>
