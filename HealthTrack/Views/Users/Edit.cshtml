@model UserEditPageViewModel
@using HealthTrack.Data
@using HealthTrack.Helpers
@{
    ViewData["Title"] = Model.Form.FullName;
    var disabled = AccountStatus.IsDisabled(Model.LockoutEnd);
    var locked = AccountStatus.IsLockedOut(Model.LockoutEnd);
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Form.FullName</li>
        </ol>
    </nav>

    <div class="ht-dash-header">
        <div>
            <span class="badge rounded-pill @AccountStatus.Badge(Model.LockoutEnd) mb-2">@AccountStatus.Label(Model.LockoutEnd)</span>
            <h1 class="h3 mb-1">@Model.Form.FullName</h1>
            <p class="text-muted mb-0">
                Joined @Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy") · last sign-in @(Model.LastLoginAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "never")
                @if (Model.TrainerName is not null) { <span> · trainer @Model.TrainerName</span> }
            </p>
        </div>
        @if (Model.Form.Role is Roles.Trainer or Roles.Professional)
        {
            <a class="btn btn-outline-primary btn-sm" asp-controller="Providers" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-star"></i> Profile &amp; reviews</a>
        }
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-person"></i> Profile and role</h2>
                </div>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <partial name="_UserFields" for="Form" view-data='new ViewDataDictionary(ViewData) { ["RoleLocked"] = Model.IsSelf }' />
                    @if (!Model.IsSelf)
                    {
                        <p class="form-text">Changing the role signs the user out. Trainers must have no assigned clients, and nobody can have upcoming appointments.</p>
                    }
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
                </form>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="ht-panel mb-3">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-key"></i> Reset password</h2>
                </div>
                <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" novalidate>
                    <div class="mb-2">
                        <label asp-for="Reset.NewPassword" class="form-label"></label>
                        <input asp-for="Reset.NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Reset.NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Reset.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Reset.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Reset.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-primary">Set new password</button>
                </form>
            </div>

            @if (Model.Form.Role is Roles.Trainer or Roles.Professional)
            {
                <div class="ht-panel mb-3">
                    <div class="ht-panel-header">
                        <h2 class="h6 mb-0"><i class="bi bi-person-vcard"></i> @(Model.Form.Role == Roles.Trainer ? "Coaching details" : "Practice details")</h2>
                    </div>
                    @if (Model.RoleDetails.Count == 0)
                    {
                        <p class="text-muted small mb-0">Not added yet. The user can add them under My account.</p>
                    }
                    else
                    {
                        <dl class="row ht-profile mb-0">
                            @foreach (var (label, value) in Model.RoleDetails)
                            {
                                <dt class="col-sm-5">@label</dt>
                                <dd class="col-sm-7 text-break">@value</dd>
                            }
                        </dl>
                    }
                </div>
            }

            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-shield-lock"></i> Access</h2>
                </div>
                @if (Model.IsSelf)
                {
                    <p class="text-muted small mb-0">This is your account. You can't disable it.</p>
                }
                else if (disabled || locked)
                {
                    <p class="small text-muted">
                        @(disabled ? "This account is disabled, so the user can't sign in." : $"Locked after failed sign-ins until {Model.LockoutEnd!.Value.ToLocalTime():HH:mm}.")
                    </p>
                    <form asp-action="SetEnabled" asp-route-id="@Model.Id" asp-route-enabled="true" method="post">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-unlock"></i> @(disabled ? "Enable account" : "Unlock now")</button>
                    </form>
                }
                else
                {
                    <p class="small text-muted">Disabling signs the user out and stops them signing in. Their data is kept.</p>
                    <form asp-action="SetEnabled" asp-route-id="@Model.Id" asp-route-enabled="false" method="post"
                          data-confirm="Disable @Model.Form.FullName's account?">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-slash-circle"></i> Disable account</button>
                    </form>
                }
                @if (!Model.IsSelf && Model.Form.Role == Roles.Client)
                {
                    <hr />
                    <p class="small text-muted">Deleting removes the client and all of their health data permanently, for example after an erasure request.</p>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          data-confirm="Permanently delete @Model.Form.FullName and all of their data? This can't be undone.">
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash3"></i> Delete account and data</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
