@model HealthTrack.Models.ViewModels.MemberDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <span class="badge rounded-pill bg-primary-subtle text-primary mb-2">Client</span>
            <h1 class="h3 mb-1">Hi, @Model.FirstName</h1>
            <p class="text-muted mb-0">Here's an overview of your health and fitness.</p>
        </div>
        <span class="text-muted small">@DateTime.Today.ToString("dddd, d MMMM yyyy")</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-speedometer2", "Current weight", "—", "No measurements yet")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-heart-pulse", "BMI", "—", "No measurements yet")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-activity", "Workouts this week", "0", "None logged")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-calendar-check", "Upcoming appointments", "0", "None booked")' /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="ht-panel mb-3">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-activity"></i> Workout plan</h2>
                </div>
                <partial name="_EmptyState" model='new EmptyState("bi-clipboard", "Your trainer hasn’t assigned a workout plan yet.")' />
            </div>
            <div class="ht-panel mb-3">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-egg-fried"></i> Diet schedule</h2>
                </div>
                <partial name="_EmptyState" model='new EmptyState("bi-basket", "No diet schedule has been set for you yet.")' />
            </div>
            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-calendar-check"></i> Upcoming appointments</h2>
                </div>
                <partial name="_EmptyState" model='new EmptyState("bi-calendar", "You have no upcoming appointments.")' />
            </div>
        </div>
        <div class="col-lg-4">
            <partial name="_ProfileCard" model="Model" />
        </div>
    </div>
</div>
