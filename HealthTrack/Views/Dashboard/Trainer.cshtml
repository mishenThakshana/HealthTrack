@model HealthTrack.Models.ViewModels.MemberDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <span class="badge rounded-pill bg-primary-subtle text-primary mb-2">Trainer</span>
            <h1 class="h3 mb-1">Hi, @Model.FirstName</h1>
            <p class="text-muted mb-0">Track your clients, routines and appointments.</p>
        </div>
        <span class="text-muted small">@DateTime.Today.ToString("dddd, d MMMM yyyy")</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-people", "My clients", "0", "None assigned")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-clipboard-check", "Active plans", "0", "None created")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-hourglass-split", "Pending requests", "0", "Nothing to review")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-calendar-check", "Appointments today", "0", "None scheduled")' /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="ht-panel mb-3">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-people"></i> Client progress</h2>
                </div>
                <partial name="_EmptyState" model='new EmptyState("bi-graph-up", "No clients are assigned to you yet.")' />
            </div>
            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-calendar-event"></i> Appointment requests</h2>
                </div>
                <partial name="_EmptyState" model='new EmptyState("bi-inbox", "No appointment requests to review.")' />
            </div>
        </div>
        <div class="col-lg-4">
            <partial name="_ProfileCard" model="Model" />
        </div>
    </div>
</div>
