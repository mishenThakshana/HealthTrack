@model TrainerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <span class="badge rounded-pill bg-primary-subtle text-primary mb-2">Trainer</span>
            <h1 class="h3 mb-1">Hi, @Model.Profile.FirstName</h1>
            <p class="text-muted mb-0">Track your clients, routines and appointments.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-sm" asp-controller="WorkoutPlans" asp-action="Create"><i class="bi bi-plus-lg"></i> Workout plan</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="DietPlans" asp-action="Create"><i class="bi bi-plus-lg"></i> Diet plan</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-people", "My clients", Model.Clients.Count.ToString(), Model.Clients.Count == 0 ? "None assigned" : "Assigned to you")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-clipboard-check", "Active plans", Model.ActivePlans.ToString(), "Workout and diet")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-activity", "Client workouts", Model.ClientWorkoutsThisWeek.ToString(), "Logged this week")' /></div>
        <div class="col-6 col-lg-3"><partial name="_StatTile" model='new StatTile("bi-calendar-check", "Appointments today", "0", "None scheduled")' /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="ht-panel">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-people"></i> Client progress</h2>
                    @if (Model.Clients.Count > 0)
                    {
                        <a class="small" asp-controller="Clients" asp-action="Index">All clients <i class="bi bi-chevron-right"></i></a>
                    }
                </div>
                @if (Model.Clients.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyState("bi-graph-up", "No clients are assigned to you yet.")' />
                }
                else
                {
                    <partial name="_ClientTable" model="Model.Clients" />
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ht-panel mb-3">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-calendar-event"></i> Appointment requests</h2>
                </div>
                <partial name="_EmptyState" model='new EmptyState("bi-inbox", "No appointment requests to review.")' />
            </div>
            <partial name="_ProfileCard" model="Model.Profile" />
        </div>
    </div>
</div>
