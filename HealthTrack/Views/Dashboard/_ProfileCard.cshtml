@model HealthTrack.Models.ViewModels.MemberDashboardViewModel

<div class="ht-panel">
    <div class="ht-panel-header">
        <h2 class="h6 mb-0"><i class="bi bi-person-badge"></i> My profile</h2>
        <div class="d-flex gap-3">
            @if (Model.Rating is not null)
            {
                <a class="small" asp-controller="Providers" asp-action="Details" asp-route-id="@Model.Avatar.UserId">Public profile</a>
            }
            <a class="small" asp-controller="Account" asp-action="Manage">Edit <i class="bi bi-chevron-right"></i></a>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3 mb-3">
        <partial name="_Avatar" model="Model.Avatar" />
        <div class="ht-min-w-0">
            <div class="fw-semibold text-truncate">@Model.FullName</div>
            @if (Model.Rating is not null)
            {
                <a class="d-block text-decoration-none" asp-controller="Providers" asp-action="Details" asp-route-id="@Model.Avatar.UserId" asp-fragment="reviews"
                   title="See your profile and reviews as clients see them"><partial name="_Stars" model="Model.Rating" /></a>
            }
            @if (Model.Avatar.PhotoUpdatedAt is null)
            {
                <a class="small" asp-controller="Account" asp-action="Manage" asp-fragment="photo">Add a profile picture</a>
            }
        </div>
    </div>
    <dl class="ht-profile mb-0">
        <dt>Email</dt>
        <dd class="text-break">@Model.Email</dd>
        @if (Model.Age is not null)
        {
            <dt>Age</dt>
            <dd>@Model.Age</dd>
        }
        <dt>Gender</dt>
        <dd>@(Model.Gender ?? "Not set")</dd>
        @foreach (var (label, value) in Model.Details)
        {
            <dt>@label</dt>
            <dd class="text-break">@value</dd>
        }
        <dt>Member since</dt>
        <dd>@Model.MemberSince.ToLocalTime().ToString("d MMM yyyy")</dd>
    </dl>
    @if (Model.DetailsMissing)
    {
        <div class="ht-note small mt-3">
            <i class="bi bi-info-circle text-primary"></i>
            Your profile is missing some details. <a asp-controller="Account" asp-action="Manage" asp-fragment="details">Add them now</a>.
        </div>
    }
</div>
