@model HealthTrack.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <span class="badge rounded-pill bg-primary-subtle text-primary mb-2">Administrator</span>
            <h1 class="h3 mb-1">System overview</h1>
            <p class="text-muted mb-0">User activity, system usage and trainer assignments.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-sm" asp-controller="Users" asp-action="Create"><i class="bi bi-person-plus"></i> New user</a>
            <a class="btn btn-outline-primary btn-sm" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> Reports</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl"><partial name="_StatTile" model='new StatTile("bi-people", "Total users", Model.TotalUsers.ToString(), $"{Model.NewThisWeek} new this week")' /></div>
        <div class="col-6 col-md-4 col-xl"><partial name="_StatTile" model='new StatTile("bi-person-check", "Active", Model.ActiveThisWeek.ToString(), "Signed in this week")' /></div>
        <div class="col-6 col-md-4 col-xl"><partial name="_StatTile" model='new StatTile("bi-person", "Clients", Model.Clients.ToString(), "Registered clients")' /></div>
        <div class="col-6 col-md-4 col-xl"><partial name="_StatTile" model='new StatTile("bi-person-workspace", "Trainers", Model.Trainers.ToString(), "Registered trainers")' /></div>
        <div class="col-6 col-md-4 col-xl"><partial name="_StatTile" model='new StatTile("bi-person-lock", "Locked", Model.LockedOut.ToString(), "Disabled or locked out")' /></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="ht-panel h-100">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-bar-chart"></i> System usage · last 14 days</h2>
                </div>
                <partial name="_Chart" model="Model.Usage" view-data='new ViewDataDictionary(ViewData) { ["Empty"] = "Nothing has been logged in the last 14 days." }' />
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ht-panel h-100">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-database"></i> Totals</h2>
                    <span class="small text-muted">this week</span>
                </div>
                <ul class="list-unstyled ht-item-list mb-0">
                    @foreach (var u in Model.UsageTotals)
                    {
                        <li>
                            <i class="bi @u.Icon text-primary"></i>
                            <div class="flex-grow-1">@u.Label</div>
                            <span class="fw-semibold">@u.Total.ToString("N0")</span>
                            <span class="small text-muted ht-usage-week">+@u.ThisWeek</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="ht-panel h-100">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-person-plus"></i> Recent registrations</h2>
                    <a class="small" asp-controller="Users" asp-action="Index">All users <i class="bi bi-chevron-right"></i></a>
                </div>
                @if (Model.RecentUsers.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyState("bi-people", "No users yet.")' />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table ht-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Role</th>
                                    <th class="text-end">Joined</th>
                                    <th class="text-end d-none d-sm-table-cell">Last sign-in</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@user.FullName</div>
                                            <div class="small text-muted text-break">@user.Email</div>
                                        </td>
                                        <td><span class="badge rounded-pill bg-primary-subtle text-primary">@user.Role</span></td>
                                        <td class="text-end text-nowrap small">@user.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                        <td class="text-end text-nowrap small d-none d-sm-table-cell">@(user.LastLoginAt?.ToLocalTime().ToString("d MMM, HH:mm") ?? "Never")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ht-panel h-100">
                <div class="ht-panel-header">
                    <h2 class="h6 mb-0"><i class="bi bi-diagram-3"></i> Trainer assignments</h2>
                    <a class="small" asp-controller="TrainerAssignments" asp-action="Index">Manage <i class="bi bi-chevron-right"></i></a>
                </div>
                <p class="small text-muted">
                    @Model.AssignedClients of @Model.Clients client@(Model.Clients == 1 ? "" : "s") assigned to a trainer.
                </p>
                @if (Model.TrainerLoads.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyState("bi-person-workspace", "No trainers have registered yet.")' />
                }
                else
                {
                    <partial name="_TrainerLoads" model="Model.TrainerLoads" />
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ChartScripts" />
}
