@model IReadOnlyList<HealthMeasurement>
@{
    var canManage = ViewData["CanManage"] is true;
    var editingId = ViewData["EditingId"] as int?;
}

<div class="table-responsive">
    <table class="table ht-table align-middle mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th class="text-end">Weight</th>
                <th class="text-end">BMI</th>
                <th class="text-end d-none d-sm-table-cell">Body fat</th>
                <th class="text-end d-none d-sm-table-cell">Resting HR</th>
                @if (canManage) { <th><span class="visually-hidden">Actions</span></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr class="@(m.Id == editingId ? "ht-editing" : null)">
                    <td class="text-nowrap">
                        @m.Date.ToString("d MMM yyyy")
                        @if (!string.IsNullOrWhiteSpace(m.Notes)) { <div class="small text-muted">@m.Notes</div> }
                    </td>
                    <td class="text-end text-nowrap fw-semibold">@m.WeightKg.ToString("0.0") kg</td>
                    <td class="text-end">@(m.Bmi?.ToString("0.0") ?? "—")</td>
                    <td class="text-end d-none d-sm-table-cell">@(m.BodyFatPercent is { } bf ? $"{bf:0.0}%" : "—")</td>
                    <td class="text-end d-none d-sm-table-cell">@(m.RestingHeartRate is { } hr ? $"{hr} bpm" : "—")</td>
                    @if (canManage)
                    {
                        <td class="text-end text-nowrap">
                            <partial name="_EditLink" model="m.Id" />
                            <partial name="_DeleteButton" model='new DeleteButton("Measurements", "Delete", new() { ["id"] = m.Id.ToString() }, "Delete this measurement?")' />
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
