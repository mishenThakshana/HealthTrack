@model PlanFormViewModel
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var isDiet = controller == "DietPlans";
    var noun = isDiet ? "diet plan" : "workout plan";
    var editing = Model.Id is not null;
    ViewData["Title"] = editing ? $"Edit {noun}" : $"New {noun}";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index">@(isDiet ? "Diet plans" : "Workout plans")</a></li>
            @if (editing)
            {
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@(editing ? "Edit" : "New")</li>
        </ol>
    </nav>

    <div class="ht-panel ht-form-panel mx-auto">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="ht-icon"><i class="bi @(isDiet ? "bi-egg-fried" : "bi-activity")"></i></div>
            <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        </div>

        @if (!Model.Clients.Any())
        {
            <partial name="_EmptyState" model='new EmptyState("bi-people", "You don’t have any clients yet. An administrator needs to assign clients to you first.")' />
        }
        else
        {
            <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ClientId" class="form-label"></label>
                    <select asp-for="ClientId" asp-items="Model.Clients" class="form-select">
                        <option value="">Choose a client</option>
                    </select>
                    <span asp-validation-for="ClientId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="@(isDiet ? "e.g. Lean cut – 2,000 kcal" : "e.g. 4-week strength builder")" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Goals, guidance or anything the client should know"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="EndDate" class="form-label"></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                @if (isDiet)
                {
                    <div class="mb-3">
                        <label asp-for="DailyCalorieTarget" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DailyCalorieTarget" type="number" class="form-control" placeholder="e.g. 2000" />
                            <span class="input-group-text">kcal</span>
                        </div>
                        <span asp-validation-for="DailyCalorieTarget" class="text-danger small"></span>
                    </div>
                }

                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" role="switch" />
                    <label asp-for="IsActive" class="form-check-label">Active (shown on the client's dashboard)</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(editing ? "Save changes" : "Create plan")</button>
                    <a class="btn btn-outline-primary" asp-action="@(editing ? "Details" : "Index")" asp-route-id="@Model.Id">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
