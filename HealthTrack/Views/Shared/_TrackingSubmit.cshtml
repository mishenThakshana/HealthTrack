@model int?

@if (Model is null)
{
    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> @ViewData["Save"]</button>
}
else
{
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-check-lg"></i> Save changes</button>
        <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
    </div>
}
