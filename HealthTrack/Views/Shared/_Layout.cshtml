@using HealthTrack.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    string NavActive(string controller, string? action = null) =>
        string.Equals(ViewContext.RouteData.Values["controller"] as string, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(ViewContext.RouteData.Values["action"] as string, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : string.Empty;

    string NavActiveAny(params string[] controllers) =>
        controllers.Any(c => NavActive(c) == "active") ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark ht-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill"></i> HealthTrack
                </a>
                <partial name="_LoginPartial" />
                <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto ms-lg-3 gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Home", "Index")" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i> Home
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Trainer))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActiveAny("Clients", "Progress")" asp-controller="Clients" asp-action="Index">
                                    <i class="bi bi-people"></i> Clients
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Trainer) || User.IsInRole(Roles.Client))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @NavActiveAny("WorkoutPlans", "DietPlans")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard-check"></i> Plans
                                </a>
                                <ul class="dropdown-menu ht-user-menu">
                                    <li><a class="dropdown-item" asp-controller="WorkoutPlans" asp-action="Index"><i class="bi bi-activity"></i> Workout plans</a></li>
                                    <li><a class="dropdown-item" asp-controller="DietPlans" asp-action="Index"><i class="bi bi-egg-fried"></i> Diet plans</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Trainer) || User.IsInRole(Roles.Professional) || User.IsInRole(Roles.Client) || User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Appointments")" asp-controller="Appointments" asp-action="Index">
                                    <i class="bi bi-calendar-check"></i> Appointments
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Client))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @NavActiveAny("WorkoutLogs", "MealLogs", "Measurements", "Progress")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-journal-plus"></i> Track
                                </a>
                                <ul class="dropdown-menu ht-user-menu">
                                    <li><a class="dropdown-item" asp-controller="WorkoutLogs" asp-action="Index"><i class="bi bi-activity"></i> Workouts</a></li>
                                    <li><a class="dropdown-item" asp-controller="MealLogs" asp-action="Index"><i class="bi bi-egg-fried"></i> Meals</a></li>
                                    <li><a class="dropdown-item" asp-controller="Measurements" asp-action="Index"><i class="bi bi-rulers"></i> Measurements</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Progress" asp-action="Index"><i class="bi bi-graph-up"></i> Progress</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Users")" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-person-gear"></i> Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActive("TrainerAssignments")" asp-controller="TrainerAssignments" asp-action="Index">
                                    <i class="bi bi-diagram-3"></i> Assignments
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(Roles.Trainer) || User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Reports")" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart"></i> Reports
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-4">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show ht-alert" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@success</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show ht-alert" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@error</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (currentUser is { EmailConfirmed: false })
        {
            <div class="container mt-3">
                <div class="ht-note d-flex flex-wrap align-items-center gap-2 small">
                    <i class="bi bi-envelope-exclamation text-primary"></i>
                    <span class="flex-grow-1">Please confirm your email (@currentUser.Email) so we can send you reminders and updates.</span>
                    <form asp-controller="Account" asp-action="ResendConfirmation" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Resend link</button>
                    </form>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="ht-footer">
        <div class="container d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year HealthTrack &middot; Personal Health &amp; Fitness</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
