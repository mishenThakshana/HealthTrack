@model IReadOnlyList<Appointment>

@if (Model.Count == 0)
{
    <partial name="_EmptyState" model='new EmptyState((string)ViewData["EmptyIcon"]!, (string)ViewData["Empty"]!)' />
}
else
{
    <ul class="list-unstyled ht-item-list mb-0">
        @foreach (var appointment in Model)
        {
            <partial name="_AppointmentItem" model="appointment" view-data="ViewData" />
        }
    </ul>
}
