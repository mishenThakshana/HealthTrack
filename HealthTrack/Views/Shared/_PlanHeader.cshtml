@model HealthTrack.Models.ViewModels.PlanHeader

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">@Model.ListTitle</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="ht-dash-header">
    <div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <partial name="_PlanStatus" model="Model.IsActive" />
            <span class="small text-muted">
                <i class="bi bi-calendar3"></i> @Model.StartDate.ToString("d MMM yyyy")@(Model.EndDate is { } end ? $" – {end:d MMM yyyy}" : " onwards")
            </span>
        </div>
        <h1 class="h3 mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">
            For <span class="fw-semibold text-body">@Model.ClientName</span> · by <span class="fw-semibold text-body">@Model.TrainerName</span>
        </p>
    </div>
    @if (Model.CanEdit)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
            <partial name="_DeleteButton" model='new DeleteButton(ViewContext.RouteData.Values["controller"]!.ToString()!, "Delete",
                new() { ["id"] = Model.Id.ToString() }, $"Delete \"{Model.Title}\"? This can’t be undone.", "Delete")' />
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <div class="ht-panel mb-3">
        <p class="mb-0 ht-prewrap">@Model.Description</p>
    </div>
}
