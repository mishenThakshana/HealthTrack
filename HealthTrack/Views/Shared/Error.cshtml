@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="ht-icon mb-3"><i class="bi bi-exclamation-triangle"></i></div>
    <h1 class="h2">Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
