@using HealthTrack.Helpers
@model ProvidersPageViewModel
@{
    ViewData["Title"] = "Find a trainer";
    var mine = Model.MyTrainer;
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <h1 class="h3 mb-1">Find a trainer</h1>
            <p class="text-muted mb-0">Choose a trainer to plan your workouts and diet and follow your progress. You can book a consultation with any trainer.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="ht-panel h-100 d-flex align-items-center gap-3">
                @if (mine is null)
                {
                    <span class="ht-avatar ht-avatar-md" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
                    <div class="flex-grow-1">
                        <div class="small text-muted">Your trainer</div>
                        <div class="fw-semibold">Not chosen yet</div>
                    </div>
                }
                else
                {
                    <partial name="_Avatar" model='mine.Avatar("ht-avatar-md")' />
                    <div class="flex-grow-1 ht-min-w-0">
                        <div class="small text-muted">Your trainer</div>
                        <div class="fw-semibold text-truncate"><a class="text-reset" asp-action="Details" asp-route-id="@mine.Id">@mine.FullName</a></div>
                        @if (mine.Headline is not null) { <div class="small text-muted text-truncate">@mine.Headline</div> }
                    </div>
                    <form asp-action="Leave" method="post" data-confirm="Remove @mine.FullName as your trainer? They will no longer see your progress.">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Remove</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-sm-12 col-lg-4">
            <input name="q" value="@Model.Search" class="form-control" maxlength="100" placeholder="Search by name, specialization or qualification" aria-label="Search" />
        </div>
        <div class="col-sm-5 col-lg-3">
            <select name="focus" class="form-select" aria-label="Specialization">
                <option value="">All specializations</option>
                @foreach (var option in Model.FocusOptions)
                {
                    <option value="@option" selected="@(option == Model.Focus)">@option</option>
                }
            </select>
        </div>
        <div class="col-sm-4 col-lg-2">
            <select name="sort" class="form-select" aria-label="Sort by">
                <option value="">Sort by name</option>
                <option value="rating" selected="@Model.SortByRating">Top rated</option>
            </select>
        </div>
        <div class="col-sm-3 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> <span class="d-sm-none d-lg-inline">Search</span></button>
            @if (Model.Search is not null || Model.Focus is not null || Model.SortByRating)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </form>

    @if (Model.Providers.Count == 0)
    {
        <div class="ht-panel">
            <partial name="_EmptyState" model='new EmptyState("bi-search", Model.Search is null && Model.Focus is null ? $"There are no trainers on HealthTrack yet." : $"No trainers match your search.")' />
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var p in Model.Providers)
            {
                var isMine = p.Id == mine?.Id;
                <div class="col-md-6 col-xl-4">
                    <div class="ht-panel h-100 d-flex flex-column ht-provider @(isMine ? "ht-provider-mine" : "")">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <partial name="_Avatar" model='p.Avatar("ht-avatar-lg")' />
                            <div class="ht-min-w-0">
                                <h2 class="h6 mb-1 text-truncate"><a class="text-reset" asp-action="Details" asp-route-id="@p.Id">@p.FullName</a></h2>
                                @if (p.Headline is not null) { <div class="small fw-semibold text-primary">@p.Headline</div> }
                                @if (p.YearsOfExperience is { } years) { <div class="small text-muted">@ProfileOptions.Experience(years)</div> }
                            </div>
                        </div>
                        @if (p.Qualifications.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var qualification in p.Qualifications)
                                {
                                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-normal">@qualification</span>
                                }
                            </div>
                        }
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <a asp-action="Details" asp-route-id="@p.Id" asp-fragment="reviews" class="text-decoration-none"><partial name="_Stars" model="p.Rating" /></a>
                            <span class="small text-muted"><i class="bi bi-people"></i> @p.ClientCount client@(p.ClientCount == 1 ? "" : "s")</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            @if (isMine)
                            {
                                <span class="badge rounded-pill ht-badge-active align-self-center"><i class="bi bi-check-lg"></i> Your trainer</span>
                            }
                            else
                            {
                                <form asp-action="Choose" asp-route-id="@p.Id" method="post"
                                      data-confirm="@(mine is null ? null : $"Replace {mine.FullName} with {p.FullName} as your trainer?")">
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-person-check"></i> Choose as my trainer</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Appointments" asp-action="Index" asp-route-with="@p.Id" asp-fragment="book">
                                <i class="bi bi-calendar-plus"></i> Book
                            </a>
                            <a class="btn btn-sm btn-link" asp-action="Details" asp-route-id="@p.Id">Profile &amp; reviews</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
