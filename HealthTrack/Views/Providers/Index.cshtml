@using HealthTrack.Data
@using HealthTrack.Helpers
@model ProvidersPageViewModel
@{
    ViewData["Title"] = "Trainers & health professionals";
    var show = Model.ShowProfessionals ? "professionals" : null;
}

<div class="container py-4">
    <div class="ht-dash-header">
        <div>
            <h1 class="h3 mb-1">Trainers &amp; health professionals</h1>
            <p class="text-muted mb-0">Choose a trainer to plan your workouts and diet, and a health professional to keep an eye on your progress.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var (role, label, choice) in new[] { (Roles.Trainer, "trainer", Model.MyTrainer), (Roles.Professional, "health professional", Model.MyProfessional) })
        {
            <div class="col-md-6">
                <div class="ht-panel h-100 d-flex align-items-center gap-3">
                    @if (choice is null)
                    {
                        <span class="ht-avatar ht-avatar-md" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
                        <div class="flex-grow-1">
                            <div class="small text-muted">Your @label</div>
                            <div class="fw-semibold">Not chosen yet</div>
                        </div>
                    }
                    else
                    {
                        <partial name="_Avatar" model='choice.Avatar("ht-avatar-md")' />
                        <div class="flex-grow-1 ht-min-w-0">
                            <div class="small text-muted">Your @label</div>
                            <div class="fw-semibold text-truncate"><a class="text-reset" asp-action="Details" asp-route-id="@choice.Id">@choice.FullName</a></div>
                            @if (choice.Headline is not null) { <div class="small text-muted text-truncate">@choice.Headline</div> }
                        </div>
                        <form asp-action="Leave" asp-route-role="@role" method="post" data-confirm="Remove @choice.FullName as your @label? They will no longer see your progress.">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Remove</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a class="nav-link @(Model.ShowProfessionals ? "" : "active")" asp-action="Index"><i class="bi bi-person-arms-up"></i> Trainers</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ShowProfessionals ? "active" : "")" asp-action="Index" asp-route-show="professionals"><i class="bi bi-hospital"></i> Health professionals</a>
        </li>
    </ul>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        @if (show is not null) { <input type="hidden" name="show" value="@show" /> }
        <div class="col-sm-12 col-lg-4">
            <input name="q" value="@Model.Search" class="form-control" maxlength="100" placeholder="Search by name, @(Model.ShowProfessionals ? "profession or workplace" : "specialization or qualification")" aria-label="Search" />
        </div>
        <div class="col-sm-5 col-lg-3">
            <select name="focus" class="form-select" aria-label="@(Model.ShowProfessionals ? "Profession" : "Specialization")">
                <option value="">@(Model.ShowProfessionals ? "All professions" : "All specializations")</option>
                @foreach (var option in Model.FocusOptions)
                {
                    <option value="@option" selected="@(option == Model.Focus)">@option</option>
                }
            </select>
        </div>
        <div class="col-sm-4 col-lg-2">
            <select name="sort" class="form-select" aria-label="Sort by">
                <option value="">Sort by name</option>
                <option value="rating" selected="@Model.SortByRating">Top rated</option>
            </select>
        </div>
        <div class="col-sm-3 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> <span class="d-sm-none d-lg-inline">Search</span></button>
            @if (Model.Search is not null || Model.Focus is not null || Model.SortByRating)
            {
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-show="@show">Clear</a>
            }
        </div>
    </form>

    @if (Model.Providers.Count == 0)
    {
        <div class="ht-panel">
            <partial name="_EmptyState" model='new EmptyState("bi-search", Model.Search is null && Model.Focus is null ? $"There are no {Model.Noun}s on HealthTrack yet." : $"No {Model.Noun}s match your search.")' />
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var p in Model.Providers)
            {
                var isMine = p.Id == Model.MyChoiceId;
                <div class="col-md-6 col-xl-4">
                    <div class="ht-panel h-100 d-flex flex-column ht-provider @(isMine ? "ht-provider-mine" : "")">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <partial name="_Avatar" model='p.Avatar("ht-avatar-lg")' />
                            <div class="ht-min-w-0">
                                <h2 class="h6 mb-1 text-truncate"><a class="text-reset" asp-action="Details" asp-route-id="@p.Id">@p.FullName</a></h2>
                                @if (p.Headline is not null) { <div class="small fw-semibold text-primary">@p.Headline</div> }
                                @if (p.YearsOfExperience is { } years) { <div class="small text-muted">@ProfileOptions.Experience(years)</div> }
                            </div>
                        </div>
                        @if (p.Workplace is not null)
                        {
                            <div class="small mb-2"><i class="bi bi-geo-alt text-muted"></i> @p.Workplace</div>
                        }
                        @if (p.Qualifications.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                @foreach (var qualification in p.Qualifications)
                                {
                                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-normal">@qualification</span>
                                }
                            </div>
                        }
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <a asp-action="Details" asp-route-id="@p.Id" asp-fragment="reviews" class="text-decoration-none"><partial name="_Stars" model="p.Rating" /></a>
                            <span class="small text-muted"><i class="bi bi-people"></i> @p.ClientCount client@(p.ClientCount == 1 ? "" : "s")</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            @if (isMine)
                            {
                                <span class="badge rounded-pill ht-badge-active align-self-center"><i class="bi bi-check-lg"></i> Your @Model.Noun</span>
                            }
                            else
                            {
                                var current = Model.ShowProfessionals ? Model.MyProfessional : Model.MyTrainer;
                                <form asp-action="Choose" asp-route-id="@p.Id" method="post"
                                      data-confirm="@(current is null ? null : $"Replace {current.FullName} with {p.FullName} as your {Model.Noun}?")">
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-person-check"></i> Choose as my @Model.Noun</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Appointments" asp-action="Index" asp-route-with="@p.Id" asp-fragment="book">
                                <i class="bi bi-calendar-plus"></i> Book
                            </a>
                            <a class="btn btn-sm btn-link" asp-action="Details" asp-route-id="@p.Id">Profile &amp; reviews</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
